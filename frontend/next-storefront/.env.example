# ==============================================================================
# CineCub Storefront Environment Variables
# For production Cloudflare Workers deployments, provision secrets using:
#   npx wrangler secret put JWT_SECRET
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put TMDB_API_KEY
#   npx wrangler secret put SUBDL_API_KEY
# For local Next.js development, copy this file to .env.local and populate values.
# ==============================================================================

# Authentication (HMAC-SHA256 JWT signing secret - minimum 32 characters required)
JWT_SECRET=

# Email Delivery (Resend API)
RESEND_API_KEY=
RESEND_FROM_EMAIL="CineCub <noreply@cinecub.stream>"
RESEND_FALLBACK_FROM_EMAIL="CineCub <onboarding@resend.dev>"

# Media Metadata (The Movie Database)
TMDB_API_KEY=

# Subtitles Provider (SubDL)
SUBDL_API_KEY=
