<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strict policy: only system-trusted CAs, no cleartext HTTP traffic.
         All app traffic (shell, API, streaming, embeds) is expected over HTTPS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>