---
// StreamHeaven storefront base layout — dark-neon theme, responsive, zero webfonts
const { title, description, canonical, ogType = 'website', ogImage = null, jsonLd = null } = Astro.props;
const SITE = 'https://streamheaven.online';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0f" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="StreamHeaven" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.ico" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />}
    <style is:global>
      :root {
        --bg: #0a0a0f;
        --surface: #12121c;
        --border: rgba(255,255,255,.08);
        --text: #e8e8f0;
        --text-2: #a5a6b8;
        --text-3: #7e8094;
        --purple: #9d4edd;
        --purple-deep: #7b2cbf;
        --radius: 14px;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      img { max-width: 100%; display: block; }
      a { color: inherit; text-decoration: none; }

      .sh-header {
        position: sticky; top: 0; z-index: 50;
        display: flex; align-items: center; justify-content: space-between;
        padding: 14px clamp(16px, 4vw, 40px);
        background: rgba(10,10,15,.85); backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
      }
      .sh-logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 19px; letter-spacing: -.3px; }
      .sh-logo span { color: var(--purple); }
      .sh-open-app {
        display: inline-flex; align-items: center; gap: 8px;
        background: linear-gradient(135deg, var(--purple-deep), var(--purple));
        color: #fff; font-weight: 700; font-size: 14px;
        padding: 10px 18px; border-radius: 12px; border: 0; cursor: pointer;
      }
      .sh-open-app:hover { filter: brightness(1.15); }

      main { padding: clamp(16px, 4vw, 40px); max-width: 1280px; margin: 0 auto; }

      .sh-footer {
        margin-top: 60px; padding: 24px; text-align: center;
        color: var(--text-3); font-size: 13px; border-top: 1px solid var(--border);
      }
      .sh-footer a { color: var(--text-2); }
      .sh-footer a:hover { color: var(--purple); }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 16px;
      }
      @media (min-width: 768px) { .grid { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 20px; } }

      .card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: var(--radius); overflow: hidden;
        transition: transform .18s ease, border-color .18s ease;
      }
      .card:hover { transform: translateY(-4px); border-color: rgba(157,78,221,.45); }
      .card-poster { aspect-ratio: 2 / 3; width: 100%; object-fit: cover; background: #1a1a26; }
      .card-body { padding: 10px 12px 12px; }
      .card-title { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .card-meta { font-size: 12px; color: var(--text-3); margin-top: 2px; }

      h2.section { font-size: 20px; font-weight: 800; margin: 36px 0 16px; letter-spacing: -.3px; }
      h2.section:first-child { margin-top: 0; }

      .pill {
        display: inline-block; padding: 4px 12px; border-radius: 999px;
        background: rgba(157,78,221,.14); border: 1px solid rgba(157,78,221,.3);
        color: #c77dff; font-size: 12px; font-weight: 700;
      }
    </style>
  </head>
  <body>
    <header class="sh-header">
      <a class="sh-logo" href="/">Stream<span>Heaven</span></a>
      <a class="sh-open-app" href="/index.html">▶ Open App</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="sh-footer">
      <p>© {new Date().getFullYear()} StreamHeaven · <a href="/privacy.html">Privacy</a> · <a href="/index.html">Open the full app</a></p>
    </footer>
  </body>
</html>
