---
// StreamHeaven app home — the full vanilla app shell, served verbatim.
// Source of truth: src/app/index.html (original root site file).
// Vite `?raw` inlines it at build time (Workers have no fs at runtime),
// and Fragment set:html emits it untouched — no Astro template parsing,
// so inline scripts/JSON-LD with braces stay exactly as authored.
// Interactive parts graduate into Svelte 5 islands incrementally.
import appHtml from '../app/index.html?raw';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-cache, must-revalidate');
---
<Fragment set:html={appHtml} />
