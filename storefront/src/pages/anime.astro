---
export const prerender = false;

import Base from '../layouts/Base.astro';
import ContinueWatching from '../components/ContinueWatching.svelte';
import Watchlist from '../components/Watchlist.svelte';
import { getAnime, buildSlug, IMG, year } from '../lib/tmdb.js';

const data = await getAnime(Astro.locals.runtime?.env, 1);
const items = (data?.results || []).filter((i) => i.poster_path && (i.name || i.title));

const pageTitle = 'Watch Anime Online Free in HD — Stream Latest Anime | StreamHeaven';
const description = 'Stream the latest anime series and movies online free in HD with English subtitles and dubs. No subscription or signup required.';
const canonical = 'https://streamheaven.online/anime';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Popular Anime Series on StreamHeaven',
  itemListElement: items.slice(0, 10).map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://streamheaven.online/series/${buildSlug(item)}`,
    name: item.name || item.title
  }))
};
---

<Base
  title={pageTitle}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
>
  <div class="anime-container">
    <div class="anime-hero">
      <span class="genre-tag">🇯🇵 Japanese Animation</span>
      <h1 class="hero-title">Watch Anime Online Free</h1>
      <p class="hero-subtitle">
        Stream popular anime series, shonen hits, and new season simulcasts in full HD.
      </p>
    </div>

    <!-- User Islands -->
    <ContinueWatching client:idle />
    <Watchlist client:idle />

    <!-- Anime Grid -->
    <section class="catalog-section">
      <div class="media-grid">
        {items.map((item) => {
          const title = item.name || item.title;
          const itemYear = year(item.first_air_date || item.release_date);
          const slug = buildSlug(item);
          const href = `/series/${slug}`;
          const rating = typeof item.vote_average === 'number' && item.vote_average > 0 ? item.vote_average.toFixed(1) : null;
          const poster = IMG.poster(item.poster_path, 'w500');

          return (
            <article class="media-card">
              <a href={href} class="poster-link" aria-label={`View ${title}`}>
                <div class="poster-box">
                  {poster && (
                    <img
                      src={poster}
                      alt={title}
                      loading="lazy"
                      width="240"
                      height="360"
                    />
                  )}
                  {rating && <span class="rating-badge">★ {rating}</span>}
                  <button
                    class="quick-play-btn"
                    data-play-id={item.id}
                    data-media-type="tv"
                    aria-label={`Play ${title}`}
                    onclick="event.preventDefault(); window.openMediaModal && window.openMediaModal(this.dataset.playId, 'tv', true);"
                  >
                    ▶
                  </button>
                </div>
              </a>
              <div class="card-details">
                <a href={href} class="title-link">
                  <h2 class="card-title">{title}</h2>
                </a>
                <div class="card-meta">
                  <span>Anime</span>
                  {itemYear && <span>· {itemYear}</span>}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </div>
</Base>

<style>
  .anime-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 16px 48px;
  }
  .anime-hero {
    padding: 32px 0 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .genre-tag {
    align-self: flex-start;
    padding: 4px 12px;
    background: rgba(235, 87, 87, 0.15);
    border: 1px solid rgba(235, 87, 87, 0.35);
    color: #ff6b6b;
    font-size: 12px;
    font-weight: 800;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .hero-title {
    font-size: clamp(26px, 4.5vw, 38px);
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.5px;
    margin: 0;
  }
  .hero-subtitle {
    color: var(--text-2, #a5a6b8);
    font-size: 14px;
    max-width: 600px;
    line-height: 1.5;
    margin: 0;
  }
  .catalog-section {
    margin-top: 16px;
  }
  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
  }
  @media (min-width: 640px) {
    .media-grid {
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 20px;
    }
  }
  @media (min-width: 1024px) {
    .media-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 24px;
    }
  }
  .media-card {
    background: #12121c;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .media-card:hover {
    transform: translateY(-4px);
    border-color: rgba(157, 78, 221, 0.45);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
  }
  .poster-box {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    background: #0d0d14;
    overflow: hidden;
  }
  .poster-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .media-card:hover .poster-box img {
    transform: scale(1.04);
  }
  .rating-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(6px);
    color: #ffc107;
    font-size: 11px;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .quick-play-btn {
    position: absolute;
    bottom: 10px;
    right: 10px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--purple, #9d4edd);
    color: #fff;
    border: none;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 2px;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.2s, transform 0.2s;
  }
  .media-card:hover .quick-play-btn {
    opacity: 1;
    transform: scale(1);
  }
  .quick-play-btn:hover {
    filter: brightness(1.15);
  }
  .card-details {
    padding: 10px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .title-link {
    color: #fff;
    text-decoration: none;
  }
  .title-link:hover {
    color: var(--purple, #9d4edd);
  }
  .card-title {
    font-size: 13px;
    font-weight: 700;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-meta {
    font-size: 11px;
    color: var(--text-3, #7e8094);
  }
</style>
