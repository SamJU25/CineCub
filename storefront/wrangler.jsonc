{
  "name": "streamheaven-storefront",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_als"],
  "routes": [
    { "pattern": "streamheaven.online/movie*", "zone_name": "streamheaven.online" },
    { "pattern": "streamheaven.online/series*", "zone_name": "streamheaven.online" },
    { "pattern": "streamheaven.online/sitemap.xml", "zone_name": "streamheaven.online" },
    { "pattern": "www.streamheaven.online/movie*", "zone_name": "streamheaven.online" },
    { "pattern": "www.streamheaven.online/series*", "zone_name": "streamheaven.online" },
    { "pattern": "www.streamheaven.online/sitemap.xml", "zone_name": "streamheaven.online" }
  ],
  "observability": {
    "enabled": true
  }
}
