{
  "name": "streamheaven-storefront",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "streamheaven.online/*", "zone_name": "streamheaven.online" },
    { "pattern": "www.streamheaven.online/*", "zone_name": "streamheaven.online" }
  ],
  "observability": {
    "enabled": true
  }
}
